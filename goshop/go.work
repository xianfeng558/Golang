go 1.25.4

// common 目录的模块路径是 git.mashibing.com/msb_47094/shopping-comm。
// 工作区会用这份本地代码，代替原来从网上拉取的公共库。
// replace 补的是 go-micro v4.8 删掉、但 Consul 插件仍要引用的 cmd 包。
// 这个文件只在 goshop 目录里生效，不会影响 GinChat 和 laomaDJ。

use (
	./common
	./payment-service
	./product-service
	./shoppingCart-service
	./trade-order
	./user-service
)

replace go-micro.dev/v4/cmd => ./compat/microcmd
